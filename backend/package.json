    "db:reset": "node src/db/reset.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:payments": "node src/services/payments/tests/payments.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  }
}
