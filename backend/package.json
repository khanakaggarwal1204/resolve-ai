{
  "name": "paypal-resolve-backend",
  "private": true,
  "version": "0.1.0",
  "description": "PayPal Resolve backend (sandbox-only hackathon MVP)",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
