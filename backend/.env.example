# --- PayPal sandbox (payments) ---
# Create a Sandbox app at developer.paypal.com -> Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=10000
PAYPAL_MAX_RETRIES=2
PAYPAL_DEFAULT_CURRENCY=USD
PAYPAL_MAX_AMOUNT=10000
# Optional: set both to use PayPal's redirect approval flow. After the buyer approves, PayPal sends them
# to RETURN_URL?token=<ORDER_ID>&PayerID=... (the app needs a page there to capture the order).
# Example: http://localhost:5173/checkout/return and http://localhost:5173/checkout/cancel
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
