# --- PayPal sandbox (payments) ---
# Create a Sandbox app at developer.paypal.com -> Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=10000
PAYPAL_MAX_RETRIES=2
PAYPAL_DEFAULT_CURRENCY=USD
PAYPAL_MAX_AMOUNT=10000
# Optional: set both to use PayPal's redirect approval flow
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# --- App core / persistence (merchant portal, cases, audit) ---
PORT=4000
# SQLite file. PostgreSQL is not wired in this build.
DATABASE_URL=sqlite:./data/resolve.db
# DEMO_MODE=true enables header-based demo login (X-Demo-User) and the seed script. Never use in production.
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5173
# Used by the AI service (Khanak); never expose to the frontend
AI_API_KEY=
