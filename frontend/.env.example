# Frontend env (Vite). Only VITE_* values are exposed to the browser.
# NEVER put PAYPAL_CLIENT_SECRET or AI_API_KEY here.

# Base path of the Express API (proxied to http://localhost:4000 in dev)
VITE_API_BASE_URL=/api

# mock   = everything mocked, no backend needed
# hybrid = real PayPal sandbox payments from the backend; cases/AI/evidence mocked (matches repo today)
# live   = everything from the backend (once case + AI routes exist)
VITE_API_MODE=mock
